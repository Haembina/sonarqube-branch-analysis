// markdownlint-cli2's configuration, read by `npm run lint:md`: a document's
// structure, which the D rules do not read.
{
  // Naming `globs` makes the ignore list necessary: markdownlint-cli2 skips
  // `node_modules` only while it chooses the files itself.
  "globs": ["**/*.md"],
  "ignores": [
    "node_modules/**",
    "build/**",
    // SonarSource's webapp, checked out as a submodule: not our documents.
    "sonarqube-webapp/**",
    // Written by the release, never by hand (D9).
    "CHANGELOG.md",
    // Claude's worktrees, each with its own `node_modules`.
    ".claude/**"
  ],
  "config": {
    // The prose here is wrapped at 120 columns, as the Java is. Tables and
    // fenced blocks cannot wrap, and a wrapped command is no longer
    // copy-pasteable (D3).
    "MD013": { "line_length": 120, "tables": false, "code_blocks": false }
  }
}
