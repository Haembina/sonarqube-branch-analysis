{
  // What the SonarQube scan reads the TypeScript with. The addons' own
  // tsconfig.json extends the webapp's, which exists only once setup.sh has
  // copied them into sonarqube-webapp; the scan runs on the repository as it
  // is checked out, where that path is missing and the analyzer would read
  // every file with no program. Imports of `~sq-server-commons` stay unresolved
  // here, as they are for ESLint; `npm run typecheck:addons` is the type check.
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["sonarqube-webapp-addons/src/**/*", "e2e/**/*", "playwright.config.ts"]
}
