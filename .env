# The SonarQube base image's tag, and the digest that pins it; change both together, and the defaults in both
# Dockerfiles with them
SONARQUBE_VERSION=26.10.0.133078-community
SONARQUBE_DIGEST=sha256:2e378f7852b67d43507d3d383ee8fb5a522b8b0f920be9803f74f72952fce8f1

# The name of the Dockerfile to run. 'Dockerfile' is building locally, 'release.Dockerfile' if building the release image
DOCKERFILE=Dockerfile

# The version of the plugin to include in the image
PLUGIN_VERSION=27.1.2

# The host port SonarQube is published on
SONARQUBE_PORT=9000
